# Pearls AQI Predictor — Environment Variables
# Copy this file to .env and fill in your values

# ── External APIs ──────────────────────────────────────────────────────────────
AQICN_API_KEY=your_aqicn_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Hopsworks Feature Store & Model Registry ───────────────────────────────────
HOPSWORKS_API_KEY=your_hopsworks_api_key_here
HOPSWORKS_PROJECT_NAME=your_hopsworks_project_name_here

# ── Flask API URL ──────────────────────────────────────────────────────────────
# Local development:
FLASK_API_URL=http://127.0.0.1:5000
# Production deployment (change to your hosted Flask URL):
# FLASK_API_URL=https://your-deployed-flask-service.com
